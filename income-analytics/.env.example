APP_NAME=Income Analytics

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# US market data (server-side only; never expose in frontend/API responses)
TWELVE_DATA_API_KEY=

# Database
DATABASE_URL=sqlite:///income_analytics.db

# Historical valuation coverage thresholds used for portfolio performance status.
INCOME_PERFORMANCE_COVERAGE_GOOD=0.95
INCOME_PERFORMANCE_COVERAGE_MINIMUM=0.90

# Firebase SaaS: keep registration closed, including on the real financial host.
# These examples are NOT loaded automatically by PowerShell or FastAPI.
INCOME_PUBLIC_SIGNUP_ENABLED=0
# Enable only in an isolated process with an explicitly disposable SQLite path:
# INCOME_AUTH_MODE=firebase
# INCOME_ENV=development
# INCOME_APP_ORIGIN=http://localhost:8002
# INCOME_ANALYTICS_DATABASE=<absolute path to a NEW disposable SQLite file>
# FIREBASE_PROJECT_ID=income-analytics-c0150
# FIREBASE_WEB_API_KEY=<existing public Web apiKey>
# FIREBASE_AUTH_DOMAIN=<existing public Web authDomain>
# FIREBASE_WEB_APP_ID=<existing public Web appId>
# GOOGLE_APPLICATION_CREDENTIALS=<absolute path to NEW private key outside repository>
# Never paste JSON or private_key here. Revoke the previously shared key first.
# Do not set FIREBASE_AUTH_EMULATOR_HOST when testing the real Firebase project.
