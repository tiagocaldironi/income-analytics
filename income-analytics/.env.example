APP_NAME=Income Analytics

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# US market data (server-side only; never expose in frontend/API responses)
TWELVE_DATA_API_KEY=

# Database
DATABASE_URL=sqlite:///income_analytics.db

# Historical valuation coverage thresholds used for portfolio performance status.
INCOME_PERFORMANCE_COVERAGE_GOOD=0.95
INCOME_PERFORMANCE_COVERAGE_MINIMUM=0.90
